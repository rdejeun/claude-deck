<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ClaudeDeck.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\fonts\Inter-Bold.otf" LogicalName="ClaudeDeck.Fonts.Inter-Bold.otf" />
    <EmbeddedResource Include="..\..\assets\fonts\Inter-SemiBold.otf" LogicalName="ClaudeDeck.Fonts.Inter-SemiBold.otf" />
    <EmbeddedResource Include="Web\*.html" LogicalName="ClaudeDeck.Web.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeDeck.Tests" />
  </ItemGroup>
</Project>
