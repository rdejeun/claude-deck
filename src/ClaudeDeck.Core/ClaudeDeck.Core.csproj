<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ClaudeDeck.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\fonts\Inter-Bold.otf" LogicalName="ClaudeDeck.Fonts.Inter-Bold.otf" />
    <EmbeddedResource Include="..\..\assets\fonts\Inter-SemiBold.otf" LogicalName="ClaudeDeck.Fonts.Inter-SemiBold.otf" />
    <EmbeddedResource Include="..\..\assets\fonts\Inter-Regular.otf" LogicalName="ClaudeDeck.Fonts.Inter-Regular.otf" />
    <EmbeddedResource Include="..\..\assets\fonts\JetBrainsMono-SemiBold.ttf" LogicalName="ClaudeDeck.Fonts.JetBrainsMono-SemiBold.ttf" />
    <EmbeddedResource Include="..\..\assets\logo\default-logo.png" LogicalName="ClaudeDeck.Logo.default-logo.png" />
    <EmbeddedResource Include="Web\*.html" LogicalName="ClaudeDeck.Web.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\animations\claude-spinner.png" LogicalName="ClaudeDeck.Animations.claude-spinner.png" />
    <EmbeddedResource Include="..\..\assets\animations\claude-spinner.json" LogicalName="ClaudeDeck.Animations.claude-spinner.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeDeck.Tests" />
  </ItemGroup>
</Project>
